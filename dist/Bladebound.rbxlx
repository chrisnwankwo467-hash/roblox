><R11>6.123233995736766e-17</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><bool name="CanCollide">false</bool><bool name="CanTouch">false</bool><Color3uint8 name="Color3uint8">4291348695</Color3uint8><token name="Material">288</token><token name="shape">2</token><Vector3 name="size"><X>0.06</X><Y>6.4</Y><Z>6.4</Z></Vector3><token name="TopSurface">0</token></Properties></Item><Item class="Part" referent="WORLD_6460"><Properties><string name="Name">EncounterSpawn_6</string><bool name="Anchored">true</bool><token name="BottomSurface">0</token><CoordinateFrame name="CFrame"><X>0</X><Y>3.2</Y><Z>-2489</Z><R00>-1</R00><R01>0</R01><R02>1.2246467991473532e-16</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>-1.2246467991473532e-16</R20><R21>0</R21><R22>-1</R22></CoordinateFrame><bool name="CanCollide">false</bool><bool name="CanQuery">false</bool><bool name="CanTouch">false</bool><Color3uint8 name="Color3uint8">4294954348</Color3uint8><token name="Material">272</token><Vector3 name="size"><X>1</X><Y>1</Y><Z>1</Z></Vector3><token name="TopSurface">0</token><float name="Transparency">1</float><BinaryString name="AttributesSerialize">AgAAAA0AAABFbmNvdW50ZXJTdGVwBgAAAAAAABhACQAAAFJvb21JbmRleAYAAAAAAAAuQA==</BinaryString></Properties></Item></Item></Item></Item><Item class="Lighting" referent="WORLD_6461"><Properties><string name="Name">Lighting</string><Color3 name="Ambient"><R>0.5490196078431373</R><G>0.5882352941176471</G><B>0.7058823529411765</B></Color3><float name="Brightness">2.8</float><float name="ClockTime">13.2</float><float name="EnvironmentDiffuseScale">0.75</float><float name="EnvironmentSpecularScale">0.45</float><float name="ExposureCompensation">0.1</float><bool name="GlobalShadows">true</bool><Color3 name="OutdoorAmbient"><R>0.7450980392156863</R><G>0.7843137254901961</G><B>0.8627450980392157</B></Color3></Properties><Item class="Atmosphere" referent="WORLD_6462"><Properties><string name="Name">SpiritbladeAtmosphere</string><Color3 name="Color"><R>0.8156862745098039</R><G>0.8901960784313725</G><B>1</B></Color3><Color3 name="Decay"><R>0.6431372549019608</R><G>0.7215686274509804</G><B>0.8588235294117647</B></Color3><float name="Density">0.16</float><float name="Haze">0.3</float><float name="Offset">0.12</float></Properties></Item><Item class="BloomEffect" referent="WORLD_6463"><Properties><string name="Name">SpiritbladeBloom</string><float name="Intensity">0.12</float><float name="Size">18</float><float name="Threshold">1.5</float></Properties></Item><Item class="ColorCorrectionEffect" referent="WORLD_6464"><Properties><string name="Name">SpiritbladeColorGrade</string><float name="Brightness">0</float><float name="Contrast">0.04</float><float name="Saturation">0.1</float><Color3 name="TintColor"><R>1</R><G>0.9803921568627451</G><B>0.9647058823529412</B></Color3></Properties></Item><Item class="SunRaysEffect" referent="WORLD_6465"><Properties><string name="Name">SpiritbladeSunRays</string><float name="Intensity">0.025</float><float name="Spread">0.75</float></Properties></Item></Item><Item class="ReplicatedStorage" referent="CODE_ReplicatedStorage"><Properties><string name="Name">ReplicatedStorage</string></Properties><Item class="ModuleScript" referent="CODE_SwordData"><Properties><string name="Name">SwordData</string><ProtectedString name="Source">--[[
	SwordData  (ModuleScript)  -&gt;  put in ReplicatedStorage and NAME IT exactly: SwordData
	Shared by the server and the client:
	  * 14 original anime weapons with distinct silhouettes; no external model assets
	  * stages, enemy HP formula, eggs/pets, auras, rebirth cost, number formatting
]]

local M = {}

M.GROUP_ID = 0 -- put your Roblox group id here for a +10% group bonus (0 = off)
M.STAGE_MINIONS = 5
M.SWING_COOLDOWN = 0.42
M.ATTACK_RANGE = 13
M.MAX_MASTERY = 100

-- Rewards belong to completed rooms, never to a client-supplied amount.
function M.roomTrophies(stage)
	return math.floor(5 * 1.65 ^ (math.clamp(stage, 1, 15) - 1))
end

function M.roomReward(stage)
	return math.floor(200 * 2.5 ^ (math.clamp(stage, 1, 15) - 1))
end

function M.masteryNeed(level)
	return math.floor(35 * 1.18 ^ math.clamp(level, 0, M.MAX_MASTERY))
end

function M.masteryMultiplier(level)
	return 1 + 0.08 * math.clamp(level, 0, M.MAX_MASTERY)
end

---------------------------------------------------------------- HELPERS
local SUFFIX = { "", "K", "M", "B", "T", "Qa", "Qi", "Sx", "Sp", "Oc", "No", "Dc" }

function M.fmt(n)
	n = math.floor(n or 0)
	if n &lt; 1000 then return tostring(n) end
	local i = 1
	while n &gt;= 1000 and i &lt; #SUFFIX do
		n /= 1000
		i += 1
	end
	return string.format("%.2f%s", n, SUFFIX[i])
end

function M.enemyHp(stage, boss)
	local base = 30 * 1.9 ^ (stage - 1)
	return math.floor(boss and base * 6 or base)
end

function M.rebirthCost(rebirths)
	return 100000 * 3 ^ rebirths
end

---------------------------------------------------------------- SWORDS
local c = Color3.fromRGB
local mat = Enum.Material

-- cost = Spirit price, mult = how much it multiplies your Spirit per click and your damage
M.SWORDS = {
	{ name = "Rusty Katana", cost = 0, mult = 1, length = 3.6, width = 0.55,
