<roblox version="4" xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd"><External>null</External><External>nil</External><Item class="Workspace" referent="RBX_Workspace"><Properties><string name="Name">Workspace</string><bool name="StreamingEnabled">true</bool><float name="StreamingMinRadius">64</float><float name="StreamingTargetRadius">256</float></Properties></Item><Item class="Lighting" referent="RBX_Lighting"><Properties><string name="Name">Lighting</string></Properties></Item><Item class="ReplicatedStorage" referent="RBX_ReplicatedStorage"><Properties><string name="Name">ReplicatedStorage</string></Properties><Item class="ModuleScript" referent="RBX_SwordData"><Properties><string name="Name">SwordData</string><ProtectedString name="Source">--[[
	SwordData  (ModuleScript)  -&gt;  put in ReplicatedStorage and NAME IT exactly: SwordData
	Shared by the server and the client:
	  * 14 original anime weapons with distinct silhouettes; no external model assets
	  * stages, enemy HP formula, eggs/pets, auras, rebirth cost, number formatting
]]

local M = {}

M.GROUP_ID = 0 -- put your Roblox group id here for a +10% group bonus (0 = off)
M.STAGE_MINIONS = 5
M.SWING_COOLDOWN = 0.42
M.ATTACK_RANGE = 13
M.MAX_MASTERY = 100

-- Rewards belong to completed rooms, never to a client-supplied amount.
function M.roomTrophies(stage)
	return math.floor(5 * 1.65 ^ (math.clamp(stage, 1, 15) - 1))
end

function M.roomReward(stage)
	return math.floor(200 * 2.5 ^ (math.clamp(stage, 1, 15) - 1))
end

function M.masteryNeed(level)
	return math.floor(35 * 1.18 ^ math.clamp(level, 0, M.MAX_MASTERY))
end

function M.masteryMultiplier(level)
	return 1 + 0.08 * math.clamp(level, 0, M.MAX_MASTERY)
end

---------------------------------------------------------------- HELPERS
local SUFFIX = { "", "K", "M", "B", "T", "Qa", "Qi", "Sx", "Sp", "Oc", "No", "Dc" }

function M.fmt(n)
	n = math.floor(n or 0)
	if n &lt; 1000 then return tostring(n) end
	local i = 1
	while n &gt;= 1000 and i &lt; #SUFFIX do
		n /= 1000
		i += 1
	end
	return string.format("%.2f%s", n, SUFFIX[i])
end

function M.enemyHp(stage, boss)
	local base = 30 * 1.9 ^ (stage - 1)
	return math.floor(boss and base * 6 or base)
end

function M.rebirthCost(rebirths)
	return 100000 * 3 ^ rebirths
end

